{
  "name": "image-cropper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "upload:cf": "opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "format-check": "biome format",
    "db:generate": "drizzle-kit generate",
    "db:flatten": "bun run flatten.ts",
    "db:migrate:local": "rimraf drizzle_flat && bun run db:flatten && bunx wrangler d1 migrations apply arcazzi --local",
    "db:migrate:prod": "rimraf drizzle_flat && bun run db:flatten && bunx wrangler d1 migrations apply arcazzi --remote"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.0",
    "@heroui/react": "3.2.1",
    "@heroui/styles": "3.2.1",
    "@hono/zod-validator": "^0.8.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/query-core": "^5.100.11",
    "@tanstack/query-db-collection": "^1.0.37",
    "@tanstack/react-db": "^0.1.84",
    "@xstate/react": "^6.1.0",
    "bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "drizzle": "^1.4.0",
    "drizzle-orm": "^1.0.0-beta.20",
    "hono": "^4.12.21",
    "jotai": "^2.20.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.16",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-timer-hook": "^4.0.5",
    "tailwindcss": "^4.3.2",
    "uuid": "^14.0.0",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-beta.20",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6",
    "wrangler": "^4.93.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
