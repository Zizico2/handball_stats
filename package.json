{
  "name": "image-cropper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "upload:cf": "opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "format-check": "biome format",
    "db:generate": "drizzle-kit generate",
    "db:flatten": "bun run flatten.ts",
    "db:migrate:local": "rimraf drizzle_flat && bun run db:flatten && bunx wrangler d1 migrations apply arcazzi --local",
    "db:migrate:prod": "rimraf drizzle_flat && bun run db:flatten && bunx wrangler d1 migrations apply arcazzi --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@clerk/nextjs": "^7.0.7",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/zod-validator": "^0.7.6",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "@opennextjs/cloudflare": "^1.16.3",
    "@tanstack/query-core": "^5.95.2",
    "@tanstack/query-db-collection": "^1.0.32",
    "@tanstack/react-db": "^0.1.79",
    "@xstate/react": "^6.1.0",
    "bun": "^1.3.11",
    "dotenv": "^17.3.1",
    "drizzle": "^1.4.0",
    "drizzle-orm": "^1.0.0-beta.20",
    "hono": "^4.12.9",
    "jotai": "^2.18.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "react-image-crop": "^11.0.10",
    "react-timer-hook": "^4.0.5",
    "uuid": "^14.0.0",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "^1.3.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-beta.20",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.64.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
