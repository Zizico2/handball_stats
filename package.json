{
  "name": "arcazzi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "biome check",
    "format": "biome format --write",
    "format-check": "biome format",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run typecheck",
    "verify": "bun run check && bun run test && bunx opennextjs-cloudflare build",
    "test:instant": "playwright test --project=instant-nav",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:shot": "playwright test --project=shot-event",
    "test:unit": "bun test src",
    "test:d1": "rimraf drizzle_flat && bun run db:flatten && vitest run --config vitest.config.mts",
    "test": "bun run test:unit && bun run test:d1",
    "db:generate": "drizzle-kit generate",
    "db:flatten": "bun run flatten.ts",
    "db:migrate:local": "rimraf drizzle_flat && bun run db:flatten && bunx wrangler d1 migrations apply arcazzi --local"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.0",
    "@heroui/react": "3.2.1",
    "@heroui/styles": "3.2.1",
    "@hono/zod-validator": "^0.8.0",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/query-core": "^5.100.11",
    "@tanstack/query-db-collection": "^1.0.37",
    "@tanstack/react-db": "^0.1.84",
    "@xstate/react": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-beta.20",
    "hono": "^4.12.30",
    "jotai": "^2.20.0",
    "lucide-react": "^1.23.0",
    "next": "^16.3.0-preview.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.16",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-timer-hook": "^4.0.5",
    "tailwindcss": "^4.3.2",
    "uuid": "^14.0.0",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@clerk/testing": "^2.2.2",
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@next/playwright": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-beta.20",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6",
    "vitest": "^4.1.0",
    "wrangler": "^4.93.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
