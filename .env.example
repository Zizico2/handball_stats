# Clerk application credentials (use test-instance values only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# Authenticated Playwright user and reset authorization
E2E_CLERK_EMAIL=replace-with-your-clerk-test-user@example.com
E2E_RESET_TOKEN=replace-with-a-random-local-only-token

# Playwright dev-server port
PLAYWRIGHT_PORT=3000

# Optional: target an already-running server instead of starting Next.js
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional: set to 1 only for a prepared local OpenNext Worker
# E2E_CLOUDFLARE_LOCAL=1
